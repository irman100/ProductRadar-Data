{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Radar research",
  "type": "object",
  "required": [
    "schema_version",
    "market",
    "researched_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "market": {
      "type": "string"
    },
    "researched_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "not_researched",
        "researched",
        "partial"
      ]
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "reasoning",
        "confidence",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "reasoning": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "accessed_at"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "accessed_at": {
                "type": "string",
                "format": "date-time"
              },
              "title": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}